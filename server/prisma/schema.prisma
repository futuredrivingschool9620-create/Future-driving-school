generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  FAILED_LOGIN
  RENEW
}

enum NotificationChannel {
  WHATSAPP
  SMS
}

enum ReminderType {
  FIFTEEN_DAY
  SEVEN_DAY_7
  SEVEN_DAY_6
  SEVEN_DAY_5
  SEVEN_DAY_4
  SEVEN_DAY_3
  SEVEN_DAY_2
  SEVEN_DAY_1
  EXPIRY_DAY
  MANUAL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  SKIPPED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

// ── Core Models ──

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs         AuditLog[]
  createdDocuments  Document[]       @relation("DocumentCreatedBy")
  updatedDocuments  Document[]       @relation("DocumentUpdatedBy")
  createdCustomers  Customer[]       @relation("CustomerCreatedBy")
  updatedCustomers  Customer[]       @relation("CustomerUpdatedBy")
  renewalHistories  RenewalHistory[]
  refreshTokens     RefreshToken[]

  @@map("admin_users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  adminId   String   @map("admin_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Customer {
  id            String   @id @default(uuid())
  firstName     String   @map("first_name")
  secondName    String?  @map("second_name")
  vehicleType   String?  @map("vehicle_type")
  phoneNumber   String   @map("phone_number")
  vehicleNumber String   @map("vehicle_number")
  remarks       String?  @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  createdByAdminId String?   @map("created_by_admin_id")
  updatedByAdminId String?   @map("updated_by_admin_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdByAdmin AdminUser? @relation("CustomerCreatedBy", fields: [createdByAdminId], references: [id])
  updatedByAdmin AdminUser? @relation("CustomerUpdatedBy", fields: [updatedByAdminId], references: [id])
  documents      Document[]
  notifications  Notification[]
  renewalHistories RenewalHistory[]

  @@index([firstName])
  @@index([secondName])
  @@index([phoneNumber])
  @@index([vehicleNumber])
  @@index([isActive])
  @@map("customers")
}

model Document {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  documentName    String   @map("document_name")  // "Insurance", "FC", "Tax", "Permit", etc.
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isActive        Boolean  @default(true) @map("is_active")
  isCurrent       Boolean  @default(true) @map("is_current")
  renewalVersion  Int      @default(1) @map("renewal_version")
  notes           String?
  createdByAdminId String  @map("created_by_admin_id")
  updatedByAdminId String? @map("updated_by_admin_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdByAdmin AdminUser  @relation("DocumentCreatedBy", fields: [createdByAdminId], references: [id])
  updatedByAdmin AdminUser? @relation("DocumentUpdatedBy", fields: [updatedByAdminId], references: [id])
  notifications  Notification[]
  renewalHistories RenewalHistory[]

  @@index([customerId])
  @@index([documentName])
  @@index([endDate])
  @@index([isActive, isCurrent])
  @@index([customerId, documentName, isCurrent])
  @@map("documents")
}

model Notification {
  id                String             @id @default(uuid())
  customerId        String             @map("customer_id")
  documentId        String             @map("document_id")
  customerName      String             @map("customer_name")
  phoneNumber       String             @map("phone_number")
  vehicleNumber     String             @map("vehicle_number")
  documentType      String             @map("document_type")
  originalExpiryDate DateTime          @map("original_expiry_date")
  currentExpiryDate DateTime           @map("current_expiry_date")
  reminderType      ReminderType       @map("reminder_type")
  message           String?
  sentDate          DateTime?          @map("sent_date")
  sentTime          String?            @map("sent_time")
  channel           NotificationChannel @default(WHATSAPP)
  deliveryStatus    DeliveryStatus     @default(QUEUED) @map("delivery_status")
  notificationStatus NotificationStatus @default(PENDING) @map("notification_status")
  cancellationReason String?           @map("cancellation_reason")
  renewalReference  String?            @map("renewal_reference")
  providerMessageId String?            @map("provider_message_id")
  calendarDay       DateTime           @map("calendar_day")  // Date only, for duplicate prevention
  createdAt         DateTime           @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Unique constraint to prevent duplicate notifications
  @@unique([customerId, documentId, reminderType, currentExpiryDate, calendarDay], name: "unique_notification_per_day")
  @@index([customerId])
  @@index([documentId])
  @@index([notificationStatus])
  @@index([sentDate])
  @@index([calendarDay])
  @@index([createdAt])
  @@map("notifications")
}

model RenewalHistory {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  documentId      String   @map("document_id")
  oldDocumentName String   @map("old_document_name")
  oldStartDate    DateTime @map("old_start_date")
  oldEndDate      DateTime @map("old_end_date")
  newStartDate    DateTime @map("new_start_date")
  newEndDate      DateTime @map("new_end_date")
  renewalDate     DateTime @default(now()) @map("renewal_date")
  adminId         String   @map("admin_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  admin    AdminUser @relation(fields: [adminId], references: [id])

  @@index([customerId])
  @@index([documentId])
  @@index([renewalDate])
  @@map("renewal_history")
}

model AuditLog {
  id           String      @id @default(uuid())
  adminId      String?     @map("admin_id")
  entityType   String      @map("entity_type")
  entityId     String      @map("entity_id")
  action       AuditAction
  previousData Json?       @map("previous_data")
  newData      Json?       @map("new_data")
  ipAddress    String?     @map("ip_address")
  createdAt    DateTime    @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id])

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}
