# Environment
NODE_ENV="development"
PORT="3001"
CORS_ORIGIN="http://localhost:5173"

# Database — PostgreSQL
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/future_driving_school"

# JWT Secrets (MUST CHANGE IN PRODUCTION! Use long random strings)
JWT_ACCESS_SECRET="CHANGE_ME_use_at_least_32_character_random_string"
JWT_REFRESH_SECRET="CHANGE_ME_use_at_least_32_character_random_string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS="7"

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS="60000"
LOGIN_RATE_LIMIT_MAX="5"

# Seed Admin Credentials (only used during initial db:seed)
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_EMAIL="admin@futuredrivingschool.com"
ADMIN_SEED_PASSWORD="Admin@123456"

# Scheduler
SCHEDULER_ENABLED="true"
SCHEDULER_CRON="0 8 * * *"
TIMEZONE="Asia/Kolkata"

# WhatsApp Business API (configure when ready)
WHATSAPP_ENABLED="false"
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# SMS Gateway (configure when ready)
SMS_ENABLED="false"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
