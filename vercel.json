{
  "buildCommand": "npx prisma@^6.9.0 generate --schema=server/prisma/schema.prisma && npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/insurance-reminders",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(index\\.html|version\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/cron/(.*)", "destination": "/api/cron/$1" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
