{
  "buildCommand": "npx prisma generate --schema=server/prisma/schema.prisma && npm run build --workspace=client && npm run build --workspace=server",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/insurance-reminders",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/cron/(.*)", "destination": "/api/cron/$1" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
